{
  "name": "react-persian-range-picker",
  "version": "1.1.2",
  "license": "MIT",
  "type": "module",
  "main": "dist/persian-range-picker.umd.js",
  "module": "dist/persian-range-picker.es.js",
  "types": "dist/index.d.ts",
  "author": "hamidreza fallahi",
  "keywords": [
    "react-persian-range-picker",
    "react",
    "datepicker",
    "date picker",
    "range picker",
    "date range picker",
    "compare range",
    "comparison range picker",
    "persian",
    "jalali",
    "jalaali",
    "shamsi",
    "persian date picker",
    "jalali datepicker",
    "jalaali datepicker",
    "react persian calendar",
    "persian calendar react",
    "shamsi datepicker",
    "gregorian",
    "time picker",
    "date mask",
    "input mask",
    "ERP",
    "analytics",
    "typescript",
    "react 19",
    "jalaali-js",
    "react jalali",
    "react shamsi"
  ],
  "description": "Jalali / Persian (Shamsi) date picker and range picker for React — DatePicker, compare ranges, keyboard mask, TimePicker. Gregorian mode, TypeScript, ERP-ready, minimal deps (jalaali-js).",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/persian-range-picker.es.js",
      "require": "./dist/persian-range-picker.umd.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hamidrezafallahi/react-persian-range-picker.git"
  },
  "bugs": {
    "url": "https://github.com/hamidrezafallahi/react-persian-range-picker/issues"
  },
  "homepage": "https://hamidrezafallahi.github.io/react-persian-range-picker/",
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "dev": "vite --config demo/vite.config.ts",
    "dev:docs": "vite",
    "build:types": "tsc --emitDeclarationOnly",
    "build:js": "rollup -c",
    "build": "npm run build:js && npm run build:types",
    "dev:demo": "vite --config demo/vite.config.ts",
    "build:demo": "vite build --config demo/vite.config.ts",
    "deploy:demo": "gh-pages -d demo/dist",
    "lint": "eslint .",
    "preview": "vite preview",
    "clean:generated": "powershell -ExecutionPolicy Bypass -File scripts/clean-generated.ps1",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node ./node_modules/vitest/vitest.mjs",
    "test:date": "node ./node_modules/vitest/vitest.mjs run src/dateEngine"
  },
  "dependencies": {
    "jalaali-js": "^1.2.0 || ^2.0.0"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    }
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.8",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@testing-library/dom": "^8.20.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^12.1.5",
    "@testing-library/user-event": "^13.5.0",
    "@types/node": "^18.19.68",
    "@types/react": "^17.0.83",
    "@types/react-dom": "^17.0.26",
    "@vitejs/plugin-react-swc": "^3.7.2",
    "gh-pages": "^5.0.0",
    "jsdom": "^22.1.0",
    "postcss": "^8.4.49",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "rollup": "^3.29.5",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-typescript2": "^0.36.0",
    "typescript": "~5.4.5",
    "vite": "^5.4.11",
    "vitest": "^1.6.1"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
